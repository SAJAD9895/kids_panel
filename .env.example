# Copy to .env.local (never commit it). Values come from YOUR Supabase project:
# Dashboard → Project Settings → API / Data API, and → Database (connection string).
# Server-only variables are marked; they must never reach a client bundle or the mobile app.

# --- clients (safe to ship) ---
SUPABASE_URL=
# "anon"/publishable key; RLS protects data
SUPABASE_PUBLISHABLE_KEY=

# --- server only (Edge Functions get these automatically from the platform) ---
# service-role / secret key: bypasses RLS
SUPABASE_SECRET_KEY=
# pooler URI, transaction mode (port 6543), for migrations/CI only
SUPABASE_DB_URL=

# --- auth providers (set in the Supabase dashboard; mirrored here for `supabase start`) ---
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- later modules (Edge Function secrets: `supabase secrets set ...`) ---
RESEND_API_KEY=
# test key (sk_test_...) until launch
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
ENTITLEMENT_TOKEN_SIGNING_KEY=
JOBS_SHARED_SECRET=
